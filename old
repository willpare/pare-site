<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pare — Your finances, always optimal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
<style>
  :root {
    --blue: #1C63FE;
    --ink: #0B1330;
    --white: #ffffff;
    --off: #F2F5FF;
    --muted: #6B7280;
    --line: #E0E7FF;
    --green: #0D9E6A;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--white); color: var(--ink); overflow-x: hidden; }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    height: 64px; display: flex; align-items: center; justify-content: space-between;
    padding: 0 48px;
    background: rgba(255,255,255,0.88); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-logo { height: 56px; }
  .nav-cta {
    font-size: 13px; font-weight: 500; color: var(--white);
    background: var(--blue); padding: 9px 20px; border-radius: 8px;
    text-decoration: none; transition: opacity 0.2s;
  }
  .nav-cta:hover { opacity: 0.85; }

  /* HERO */
  .hero {
    min-height: 100vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(28,99,254,0.04) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(28,99,254,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 100%);
    pointer-events: none;
  }
  .hero::after {
    content: ''; position: absolute; top: -120px; left: 50%; transform: translateX(-50%);
    width: 800px; height: 600px;
    background: radial-gradient(ellipse, rgba(28,99,254,0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--blue); background: rgba(28,99,254,0.06);
    border: 1px solid rgba(28,99,254,0.15); padding: 6px 14px; border-radius: 999px;
    margin-bottom: 32px; position: relative; z-index: 1;
    opacity: 0; animation: fadeUp 0.6s ease forwards 0.1s, eyebrowPulse 2.8s ease-in-out 0.8s infinite;
  }
  .hero-eyebrow::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--blue); flex-shrink: 0;
  }
  .hero-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(48px, 7vw, 88px); line-height: 1.02;
    letter-spacing: -0.03em; color: var(--ink); max-width: 800px;
    margin-bottom: 24px; position: relative; z-index: 1;
    opacity: 0; animation: fadeUp 0.7s ease forwards 0.2s;
  }
  .hero-title em { font-style: italic; color: var(--blue); }
  .hero-sub {
    font-size: clamp(16px, 2vw, 19px); font-weight: 300; color: var(--muted);
    line-height: 1.65; max-width: 500px; margin-bottom: 48px;
    position: relative; z-index: 1;
    opacity: 0; animation: fadeUp 0.7s ease forwards 0.35s;
  }

  /* WAITLIST FORM */
  .waitlist-wrap { position: relative; z-index: 1; width: 100%; max-width: 460px; opacity: 0; animation: fadeUp 0.7s ease forwards 0.5s; }
  .waitlist {
    display: flex; align-items: center;
    background: var(--white); border: 1.5px solid var(--line);
    border-radius: 14px; padding: 6px 6px 6px 20px;
    box-shadow: 0 4px 24px rgba(28,99,254,0.08), 0 1px 3px rgba(0,0,0,0.06);
    transition: box-shadow 0.2s, border-color 0.2s;
  }
  .waitlist:focus-within { border-color: var(--blue); box-shadow: 0 4px 24px rgba(28,99,254,0.16), 0 0 0 3px rgba(28,99,254,0.08); }
  .waitlist input {
    flex: 1; border: none; outline: none;
    font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 300;
    color: var(--ink); background: transparent; padding: 6px 0;
  }
  .waitlist input::placeholder { color: #B0B8CC; }
  .waitlist button {
    background: var(--blue); color: var(--white); border: none;
    border-radius: 9px; padding: 12px 22px;
    font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 500;
    cursor: pointer; white-space: nowrap;
    transition: opacity 0.2s, transform 0.15s; flex-shrink: 0;
  }
  .waitlist button:hover { opacity: 0.88; transform: translateY(-1px); }
  .waitlist button:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .hero-note { margin-top: 16px; font-size: 12px; color: #B0B8CC; font-weight: 300; position: relative; z-index: 1; opacity: 0; animation: fadeUp 0.6s ease forwards 0.65s; }

  /* SUCCESS STATE */
  .success-box {
    display: none; flex-direction: column; align-items: center; gap: 16px;
    background: var(--off); border: 1px solid var(--line); border-radius: 20px;
    padding: 32px 28px; max-width: 460px; width: 100%; position: relative; z-index: 1;
    text-align: center;
  }
  .success-box.show { display: flex; }
  .success-icon { font-size: 40px; }
  .success-title { font-family: 'Instrument Serif', serif; font-size: 26px; color: var(--ink); }
  .success-pos { font-size: 48px; font-family: 'Instrument Serif', serif; color: var(--blue); line-height: 1; }
  .success-pos-label { font-size: 13px; color: var(--muted); font-weight: 300; margin-top: -8px; }
  .success-divider { width: 100%; height: 1px; background: var(--line); }

  /* REFERRAL SECTION */
  .referral-head { font-size: 14px; font-weight: 600; color: var(--ink); }
  .referral-sub { font-size: 12px; color: var(--muted); font-weight: 300; line-height: 1.6; }
  .ref-link-wrap {
    display: flex; align-items: center; gap: 0;
    background: var(--white); border: 1px solid var(--line); border-radius: 10px;
    overflow: hidden; width: 100%;
  }
  .ref-link {
    flex: 1; padding: 10px 12px; font-size: 12px; color: var(--muted);
    font-weight: 300; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .ref-copy {
    background: var(--ink); color: var(--white); border: none;
    padding: 10px 14px; font-family: 'DM Sans', sans-serif;
    font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap;
    transition: opacity 0.2s; flex-shrink: 0;
  }
  .ref-copy:hover { opacity: 0.85; }

  /* TIERS */
  .tiers { display: flex; flex-direction: column; gap: 8px; width: 100%; text-align: left; }
  .tier {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line);
    background: var(--white); font-size: 12px;
  }
  .tier-icon { font-size: 18px; flex-shrink: 0; }
  .tier-text { flex: 1; }
  .tier-label { font-weight: 600; color: var(--ink); font-size: 12px; }
  .tier-sub { color: var(--muted); font-weight: 300; font-size: 11px; }
  .tier-count { font-size: 11px; font-weight: 600; color: var(--blue); flex-shrink: 0; }
  .tier.achieved { border-color: var(--green); background: #F0FBF6; }
  .tier.achieved .tier-label { color: var(--green); }
  .tier.achieved .tier-count { color: var(--green); }

  /* PROBLEM */
  .problem { background: var(--ink); padding: 80px 48px; text-align: center; }
  .problem-label { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.35); font-weight: 500; margin-bottom: 20px; }
  .problem-headline { font-family: 'Instrument Serif', serif; font-size: clamp(24px, 3.5vw, 40px); color: var(--white); line-height: 1.2; max-width: 700px; margin: 0 auto 48px; }
  .problem-headline em { font-style: italic; color: rgba(255,255,255,0.45); }
  .stats-row { display: grid; grid-template-columns: repeat(3, 1fr); max-width: 900px; margin: 0 auto; background: rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.06); }
  .stat { padding: 36px 32px; background: rgba(255,255,255,0.03); text-align: left; }
  .stat-n { font-family: 'Instrument Serif', serif; font-size: clamp(36px, 4vw, 52px); color: var(--blue); line-height: 1; margin-bottom: 8px; }
  .stat-label { font-size: 13px; font-weight: 500; color: var(--white); margin-bottom: 6px; }
  .stat-sub { font-size: 12px; color: rgba(255,255,255,0.4); font-weight: 300; line-height: 1.5; }

  /* HOW */
  .how { padding: 100px 48px; max-width: 1100px; margin: 0 auto; }
  .section-eyebrow { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--blue); font-weight: 500; margin-bottom: 16px; }
  .section-head { font-family: 'Instrument Serif', serif; font-size: clamp(28px, 3.5vw, 44px); line-height: 1.1; color: var(--ink); margin-bottom: 56px; max-width: 500px; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .step-num { font-family: 'Instrument Serif', serif; font-size: 48px; color: rgba(28,99,254,0.12); line-height: 1; margin-bottom: 16px; }
  .step-divider { width: 32px; height: 2px; background: var(--blue); margin-bottom: 16px; border-radius: 2px; }
  .step-title { font-size: 15px; font-weight: 600; color: var(--ink); margin-bottom: 8px; }
  .step-body { font-size: 13px; color: var(--muted); font-weight: 300; line-height: 1.7; }

  /* CTA */
  .cta-section { background: var(--ink); padding: 100px 48px; text-align: center; position: relative; overflow: hidden; }
  .cta-section::before { content: ''; position: absolute; bottom: -200px; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(ellipse, rgba(28,99,254,0.18) 0%, transparent 70%); pointer-events: none; }
  .cta-title { font-family: 'Instrument Serif', serif; font-size: clamp(32px, 4.5vw, 56px); color: var(--white); line-height: 1.05; margin-bottom: 20px; position: relative; z-index: 1; }
  .cta-title em { font-style: italic; color: rgba(255,255,255,0.5); }
  .cta-sub { font-size: 16px; color: rgba(255,255,255,0.5); font-weight: 300; margin-bottom: 40px; position: relative; z-index: 1; }
  .cta-form { display: flex; max-width: 420px; margin: 0 auto; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 5px 5px 5px 18px; position: relative; z-index: 1; transition: border-color 0.2s; }
  .cta-form:focus-within { border-color: rgba(28,99,254,0.6); }
  .cta-form input { flex: 1; background: transparent; border: none; outline: none; font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 300; color: var(--white); padding: 6px 0; }
  .cta-form input::placeholder { color: rgba(255,255,255,0.3); }
  .cta-form button { background: var(--blue); color: var(--white); border: none; border-radius: 8px; padding: 11px 20px; font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; transition: opacity 0.2s; white-space: nowrap; }
  .cta-form button:hover { opacity: 0.85; }
  .cta-form button:disabled { opacity: 0.6; cursor: not-allowed; }

  /* FOOTER */
  footer { border-top: 1px solid var(--line); padding: 56px 48px 40px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
  .footer-logo { height: 110px; opacity: 0.9; }
  .footer-legal { font-size: 11px; color: #B0B8CC; font-weight: 300; }

  /* COUNTER */
  .counter-strip { background: var(--off); border-bottom: 1px solid var(--line); padding: 12px 48px; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 13px; color: var(--muted); font-weight: 300; }
  .counter-num { font-weight: 700; color: var(--blue); font-size: 15px; }
  .counter-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); flex-shrink: 0; animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes eyebrowPulse {
    0%, 100% { background: rgba(28,99,254,0.06); border-color: rgba(28,99,254,0.15); }
    50% { background: rgba(28,99,254,0.16); border-color: rgba(28,99,254,0.45); box-shadow: 0 0 16px rgba(28,99,254,0.15); }
  }

  @media (max-width: 768px) {
    nav { padding: 0 20px; }
    .hero { padding: 100px 20px 60px; }
    .stats-row { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; gap: 24px; }
    .how, .problem, .cta-section { padding: 60px 20px; }
    footer { flex-direction: column; gap: 16px; text-align: center; padding: 24px 20px; }
    .counter-strip { padding: 12px 20px; }
  }
</style>
</head>
<body>

<nav>
  <img src="data:image/jpeg;base64," alt="Pare" class="nav-logo">
  <a href="#waitlist" class="nav-cta">Join the waitlist</a>
</nav>

<!-- Live counter strip -->
<div class="counter-strip" style="margin-top:64px;">
  <div class="counter-dot"></div>
  <span><span class="counter-num" id="counter-display">0</span> people on the waitlist</span>
</div>

<!-- HERO -->
<section class="hero" id="top">
  <div class="hero-eyebrow">Proactive financial monitoring</div>
  <h1 class="hero-title">Your finances,<br><em>always optimal.</em></h1>
  <p class="hero-sub">Pare will monitor your loans, savings, broadband and insurance — and alert you the moment a materially better deal exists. No searching. No comparing. No effort.</p>

  <!-- Form state -->
  <div class="waitlist-wrap" id="waitlist">
    <div class="waitlist" id="hero-form-wrap">
      <input type="email" id="hero-email" placeholder="Your email address" autocomplete="email">
      <button type="button" id="hero-btn" onclick="submitWaitlist('hero')">Join the Waitlist</button>
    </div>
  </div>

  <!-- Success state (hidden until submission) -->
  <div class="success-box" id="hero-success">
    <div class="success-icon">🎉</div>
    <div class="success-title">You're on the list!</div>
    <div class="success-pos" id="hero-position">—</div>
    <div class="success-pos-label">Your waitlist position</div>
    <div class="success-divider"></div>
    <div class="referral-head">Move up the list — refer a friend</div>
    <div class="referral-sub">Share your link. Every person who signs up through you moves you higher.<br>Get 3 referrals and early access is guaranteed.</div>
    <div class="ref-link-wrap">
      <div class="ref-link" id="hero-ref-link">joinpare.com?ref=...</div>
      <button class="ref-copy" onclick="copyRef('hero-ref-link')">Copy link</button>
    </div>
    <div class="tiers" id="hero-tiers">
      <div class="tier">
        <div class="tier-icon">⚡</div>
        <div class="tier-text">
          <div class="tier-label">1 referral</div>
          <div class="tier-sub">Jump 50 places in the queue</div>
        </div>
        <div class="tier-count">1 referral</div>
      </div>
      <div class="tier">
        <div class="tier-icon">🚀</div>
        <div class="tier-text">
          <div class="tier-label">3 referrals</div>
          <div class="tier-sub">Early access guaranteed</div>
        </div>
        <div class="tier-count">3 referrals</div>
      </div>
      <div class="tier">
        <div class="tier-icon">🏅</div>
        <div class="tier-text">
          <div class="tier-label">5 referrals</div>
          <div class="tier-sub">Founding member — name in the app</div>
        </div>
        <div class="tier-count">5 referrals</div>
      </div>
    </div>
  </div>

  <p class="hero-note" id="hero-note">No spam. No commitment. Be first to know when Pare launches.</p>
</section>

<!-- PROBLEM -->
<section class="problem">
  <p class="problem-label">The problem</p>
  <h2 class="problem-headline">UK households are overpaying —<br><em>and nobody is telling them.</em></h2>
  <div class="stats-row">
    <div class="stat">
      <div class="stat-n">£1,400</div>
      <div class="stat-label">Lost per household, every year</div>
      <div class="stat-sub">Lloyds Banking Group research · £14,000 over ten years</div>
    </div>
    <div class="stat">
      <div class="stat-n">19.8%</div>
      <div class="stat-label">Average APR paid — vs 5.8% best available</div>
      <div class="stat-sub">A 14-point gap. On a loan most borrowers took out years ago and have never been prompted to review. On a £10,000 loan that gap costs over £1,400 a year. Nobody has told them.</div>
    </div>
    <div class="stat">
      <div class="stat-n">49%</div>
      <div class="stat-label">Of adults feel lost on financial products</div>
      <div class="stat-sub">FCA Financial Lives Survey · most never act</div>
    </div>
  </div>
</section>

<!-- HOW -->
<section class="how">
  <p class="section-eyebrow">How it works</p>
  <h2 class="section-head">Simple for you.<br>Sophisticated underneath.</h2>
  <div class="steps">
    <div>
      <div class="step-num">01</div>
      <div class="step-divider"></div>
      <div class="step-title">Connect your accounts</div>
      <div class="step-body">Open banking connection in under two minutes. Read-only access — Pare never moves money.</div>
    </div>
    <div>
      <div class="step-num">02</div>
      <div class="step-divider"></div>
      <div class="step-title">Pare monitors continuously</div>
      <div class="step-body">Your rates are tracked against the live market every day — loans, savings, broadband, insurance.</div>
    </div>
    <div>
      <div class="step-num">03</div>
      <div class="step-divider"></div>
      <div class="step-title">Alerted only when it matters</div>
      <div class="step-body">No noise. You hear from Pare only when a better deal exists that you are likely to qualify for.</div>
    </div>
    <div>
      <div class="step-num">04</div>
      <div class="step-divider"></div>
      <div class="step-title">Switch with confidence</div>
      <div class="step-body">One tap to approve. Pare guides you through a quick, pre-filled switch — no middleman markup, no preferred partners. Ranked by what is best for you, not what pays the most.</div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <h2 class="cta-title">Stop searching.<br><em>Start being found.</em></h2>
  <p class="cta-sub">Join the waitlist and be first to access Pare when we launch.</p>
  <div class="cta-form">
    <input type="email" id="cta-email" placeholder="Your email address" autocomplete="email">
    <button type="button" id="cta-btn" onclick="submitWaitlist('cta')">Join the Waitlist</button>
  </div>
  <p style="margin-top:14px;font-size:12px;color:rgba(255,255,255,0.3);font-weight:300;position:relative;z-index:1;" id="cta-note">No spam. No commitment.</p>
</section>

<!-- FOOTER -->
<footer>
  <img src="data:image/jpeg;base64," alt="Pare" class="footer-logo">
  <p class="footer-legal">Pare Money Limited · Company No. 17211570 · Registered in England and Wales · joinpare.com</p>
</footer>

<script>
const LOOPS_API_KEY = '6ec3613c02c1432c0db843fbd8e6662c';
const BASE_URL = 'https://joinpare.com';

// ── Referral code from URL ──────────────────────────────
function getRefCode() {
  return new URLSearchParams(window.location.search).get('ref') || '';
}

// ── Generate a simple referral code from email ──────────
function makeRefCode(email) {
  let hash = 0;
  for (let c of email) hash = ((hash << 5) - hash) + c.charCodeAt(0);
  return Math.abs(hash).toString(36).substring(0, 8);
}

// ── Simulate queue position (sequential, stored in localStorage) ──
function getPosition() {
  let base = parseInt(localStorage.getItem('pare_base') || '0');
  if (!base) {
    base = Math.floor(Math.random() * 200) + 800; // start between 800-1000
    localStorage.setItem('pare_base', base);
  }
  let pos = parseInt(localStorage.getItem('pare_pos') || base);
  if (!localStorage.getItem('pare_pos')) {
    localStorage.setItem('pare_pos', pos);
  }
  return pos;
}

function incrementCounter() {
  let base = parseInt(localStorage.getItem('pare_base') || '900');
  base += 1;
  localStorage.setItem('pare_base', base);
  updateCounter();
}

function updateCounter() {
  const n = parseInt(localStorage.getItem('pare_base') || '0');
  document.getElementById('counter-display').textContent = isNaN(n) ? '0' : n.toLocaleString('en-GB');
}

updateCounter();

// ── Submit to Loops ────────────────────────────────────
async function submitWaitlist(source) {
  const emailEl = document.getElementById(source === 'hero' ? 'hero-email' : 'cta-email');
  const btn = document.getElementById(source + '-btn');
  const email = emailEl.value.trim();

  if (!email || !email.includes('@')) {
    emailEl.style.color = '#EF4444';
    emailEl.placeholder = 'Please enter a valid email';
    setTimeout(() => { emailEl.style.color = ''; emailEl.placeholder = 'Your email address'; }, 2000);
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Joining...';

  const refCode = makeRefCode(email);
  const referredBy = getRefCode();

  try {
    const res = await fetch('https://app.loops.so/api/v1/contacts/create', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + LOOPS_API_KEY
      },
      body: JSON.stringify({
        email: email,
        source: 'waitlist',
        userGroup: 'waitlist',
        mailingLists: {},
        referralCode: refCode,
        referredBy: referredBy || undefined
      })
    });

    const data = await res.json();

    if (res.ok || data.id || data.success) {
      // Success
      incrementCounter();
      const pos = getPosition();
      const refLink = BASE_URL + '?ref=' + refCode;

      if (source === 'hero') {
        document.getElementById('hero-form-wrap').style.display = 'none';
        document.getElementById('hero-note').style.display = 'none';
        document.getElementById('hero-position').textContent = '#' + pos.toLocaleString('en-GB');
        document.getElementById('hero-ref-link').textContent = refLink;
        document.getElementById('hero-ref-link').dataset.url = refLink;
        document.getElementById('hero-success').classList.add('show');
      } else {
        btn.textContent = "You're on the list!";
        btn.style.background = '#0D9E6A';
        document.getElementById('cta-note').textContent = "You're in. We'll be in touch when Pare launches.";
      }
    } else if (data.message && data.message.toLowerCase().includes('already')) {
      btn.disabled = false;
      btn.textContent = "You're already on the list!";
      setTimeout(() => { btn.textContent = 'Join the Waitlist'; btn.disabled = false; }, 3000);
    } else {
      throw new Error(data.message || 'Unknown error');
    }
  } catch (err) {
    btn.disabled = false;
    btn.textContent = 'Try again';
    setTimeout(() => { btn.textContent = 'Join the Waitlist'; }, 2000);
    console.error('Loops error:', err);
  }
}

// ── Copy referral link ─────────────────────────────────
function copyRef(elId) {
  const el = document.getElementById(elId);
  const url = el.dataset.url || el.textContent;
  navigator.clipboard.writeText(url).then(() => {
    const btn = el.nextElementSibling;
    btn.textContent = 'Copied!';
    btn.style.background = '#0D9E6A';
    setTimeout(() => { btn.textContent = 'Copy link'; btn.style.background = ''; }, 2000);
  });
}

// ── Enter key support ──────────────────────────────────
document.getElementById('hero-email').addEventListener('keydown', e => {
  if (e.key === 'Enter') submitWaitlist('hero');
});
document.getElementById('cta-email').addEventListener('keydown', e => {
  if (e.key === 'Enter') submitWaitlist('cta');
});
</script>

